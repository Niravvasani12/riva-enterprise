{
  "name": "dtf-print-solution",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "node server/mailServer.js",
    "prebuild": "node scripts/generate-sitemap.cjs",
    "build": "vite build",
    "seo:sitemap": "node scripts/generate-sitemap.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server/mailServer.js",
    "start:server": "node server/mailServer.js",
    "start:client": "serve -s dist -l $PORT"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "framer-motion": "^12.38.0",
    "nodemailer": "^7.0.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "react-intersection-observer": "^10.0.3",
    "react-router-dom": "^7.14.0",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.1",
    "vite": "^8.0.4"
  }
}
